// Handled — clientflow for independent businesses.
// Modular monolith: one schema, one database, module-per-domain.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core models)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  tasks       Task[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Workspace — every business record hangs off exactly one workspace.
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("AED")
  /// The Contacts table, remembered for the whole workspace: the columns it
  /// leaves off, and the column it is ordered by. Names come from
  /// CONTACT_COLUMNS.
  contactHiddenColumns String[] @default([])
  contactSortField     String?
  contactSortDir       String   @default("asc")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]
  stages      PipelineStage[]
  views       ProjectView[]
  projects    Project[]
  invoices    Invoice[]
  tasks       Task[]
  automations Automation[]
  automationRuns AutomationRun[]

    customFields CustomField[]

  @@map("workspace")
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  jobTitle  String?
  website   String?
  address   String?
  notes     String?
  /// Last time this contact was spoken to — typed in, not derived.
  lastInteractionAt DateTime?
  /// Loose labels, kept in the order they were added.
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects Project[]
  invoices Invoice[]
  automationRuns AutomationRun[]
  projectContacts ProjectContact[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@map("client")
}

// ---------------------------------------------------------------------------
// Projects — the "clientflow" pipeline
// ---------------------------------------------------------------------------

enum ViewLayout {
  BOARD
  LIST
}

/// A saved way of looking at the pipeline: layout, and what the cards show.
model ProjectView {
  id       String     @id @default(cuid())
  name     String
  position Int
  layout   ViewLayout @default(BOARD)
  /// The Opportunities / Projects chips above the columns.
  showGroups Boolean  @default(true)
  /// Card properties this view leaves off. Names come from CARD_PROPERTIES.
  hiddenProps String[] @default([])
  /// How this view orders the board. Null means the pipeline's own order.
  sortField   String?
  sortDir     String   @default("asc")
  /// The filters this view narrows by, as [{ field, value }]. All must match.
  filters     Json     @default("[]")
  /// The first view a workspace gets. It cannot be renamed or deleted.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, position])
  @@map("project_view")
}

/// Opportunities are work you might win; Projects are work you are doing.
enum StageGroup {
  OPPORTUNITY
  PROJECT
}

/// The pipeline columns, owned by the workspace rather than baked into an enum,
/// so a business can name and order its own process.
model PipelineStage {
  id       String     @id @default(cuid())
  name     String
  group    StageGroup @default(OPPORTUNITY)
  position Int
  /// Kept out of the board without losing the projects sitting in it.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects        Project[]
  triggers        Automation[]
  stepTargets     AutomationStep[]
  runStepTargets  AutomationRunStep[]

  @@index([workspaceId, position])
  @@map("pipeline_stage")
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  /// What kind of work this is — free text so a workspace can name its own.
  type        String?
  leadSource  String?
  /// Free text labels, in the order they were added.
  tags        String[] @default([])
  location    String?
  /// eventDate is the start; endsAt closes the range when there is one.
  eventDate   DateTime?
  endsAt      DateTime?
  allDay      Boolean      @default(true)
  timezone    String?
  /// What the main date is called. The project's own name when left unset.
  dateTitle   String?
  /// How the main date shows on a calendar once the work is booked.
  availability Availability @default(BUSY)
  valueCents  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Null only while a stage is being deleted out from under it.
  stageId     String?
  stage       PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  invoices Invoice[]
  tasks    Task[]
  automationRuns AutomationRun[]
  notes          ProjectNote[]
  files          ProjectFile[]
  messages       ProjectMessage[]
  contacts       ProjectContact[]
  dates          ProjectDate[]
  fieldValues    ProjectFieldValue[]

  @@index([workspaceId, stageId])
  @@index([clientId])
  @@map("project")
}

/// A dated note against a project. Free text, kept in order of writing.
model ProjectNote {
  id String @id @default(cuid())
  /// Empty until it is given one; the card falls back to "Untitled note".
  title String?
  /// Plain text, kept for the card preview and for searching.
  body String
  /// The note as written, with its formatting.
  bodyHtml String?
  /// Notes are private to the workspace unless this is turned on.
  sharedWithClient Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_note")
}

/// An uploaded file, or a link to one that lives somewhere else.
model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  /// Set for a linked file. Uploads carry storageKey instead.
  url       String?
  /// Where the bytes are, relative to the upload root.
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_file")
}

enum MessageStatus {
  /// Written but deliberately not sent yet.
  DRAFT
  /// Waiting for its own send time to come round.
  SCHEDULED
  /// Written and stored, but no provider was configured to deliver it.
  QUEUED
  SENT
  FAILED
}

/// An email written from a project. Kept whether or not it could be delivered,
/// so the activity trail is the same before and after a provider is wired up.
model ProjectMessage {
  id String @id @default(cuid())
  /// Every recipient, comma separated, in the order they were added.
  to        String
  subject   String
  /// Plain text, kept for previews, search and text-only mail clients.
  body      String
  /// The formatted message as written. Null for one typed in plain text.
  bodyHtml  String?
  /// [{ id, name }] of the project files sent along with it.
  attachments Json          @default("[]")
  status      MessageStatus @default(QUEUED)
  /// When it should go out. Only ever set on a scheduled message.
  scheduledFor DateTime?
  /// Why it sits where it does: provider response, or what is missing.
  detail    String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  /// Set when this was written as a reply to an earlier message.
  replyToId String?
  replyTo   ProjectMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ProjectMessage[] @relation("MessageReply")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_message")
}

// ---------------------------------------------------------------------------
// Invoices & payments — money is always integer minor units.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime?
  dueAt     DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments Payment[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([clientId])
  @@map("invoice")
}

model InvoiceItem {
  id             String @id @default(cuid())
  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  position       Int    @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_item")
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  amountCents Int
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  title       String
  done        Boolean   @default(false)
  dueAt       DateTime?
  /// Whether the due time was set, or only the date.
  dueHasTime  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Who is meant to do it. Always someone in this workspace.
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, done])
  @@index([projectId])
  @@map("task")
}

// ---------------------------------------------------------------------------
// Automations — a trigger, then steps that run on their own clock.
//
// Editing is blocked while an automation has a live run, and changes only ever
// affect runs started afterwards; steps already scheduled keep the shape they
// were created with.
// ---------------------------------------------------------------------------

enum AutomationStatus {
  ACTIVE
  INACTIVE
}

enum AutomationTrigger {
  PROJECT_CREATED
  PROJECT_STAGE_CHANGED
  CLIENT_CREATED
  INVOICE_SENT
  INVOICE_PAID
}

enum AutomationAction {
  SEND_EMAIL
  CREATE_TASK
  MOVE_STAGE
}

enum RunStatus {
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum RunStepStatus {
  PENDING
  DONE
  FAILED
}

model Automation {
  id     String            @id @default(cuid())
  name   String
  status AutomationStatus  @default(INACTIVE)
  trigger AutomationTrigger
  /// PROJECT_STAGE_CHANGED only: fires when a project enters this stage.
  triggerStageId String?
  triggerStage   PipelineStage? @relation(fields: [triggerStageId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  steps AutomationStep[]
  runs  AutomationRun[]

  @@index([workspaceId, status])
  @@map("automation")
}

model AutomationStep {
  id       String           @id @default(cuid())
  position Int
  action   AutomationAction
  /// Waited *after* the previous step finishes, so delays accumulate down the list.
  delayMinutes Int          @default(0)
  /// SEND_EMAIL: subject. CREATE_TASK: task title.
  subject     String?
  body        String?
  /// MOVE_STAGE: the stage to move the project into.
  targetStageId String?
  targetStage   PipelineStage? @relation(fields: [targetStageId], references: [id], onDelete: SetNull)

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  runSteps AutomationRunStep[]

  @@index([automationId, position])
  @@map("automation_step")
}

model AutomationRun {
  id         String    @id @default(cuid())
  status     RunStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  steps AutomationRunStep[]

  @@index([workspaceId, status])
  @@index([automationId])
  @@map("automation_run")
}

model AutomationRunStep {
  id         String        @id @default(cuid())
  position   Int
  status     RunStepStatus @default(PENDING)
  dueAt      DateTime
  executedAt DateTime?
  /// What actually happened — this is the run timeline the activity tab shows.
  detail     String?

  /// Snapshot of the step as it stood when the run started. Editing an
  /// automation must not rewrite history, so the run carries its own copy and
  /// the link back to the live step is allowed to go null.
  action        AutomationAction
  subject       String?
  body          String?
  /// The name is part of the snapshot; the link may go null if the stage dies.
  targetStageName String?
  targetStageId   String?
  targetStage     PipelineStage? @relation(fields: [targetStageId], references: [id], onDelete: SetNull)

  runId  String
  run    AutomationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId String?
  step   AutomationStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([runId, position])
  @@map("automation_run_step")
}

/// Everyone else on a project besides the client it belongs to.
model ProjectContact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@index([projectId])
  @@map("project_contact")
}

enum Availability {
  BUSY
  FREE
}

/// A date beyond the project's main one: a rehearsal, a delivery, a site visit.
model ProjectDate {
  id           String       @id @default(cuid())
  title        String
  startAt      DateTime?
  endAt        DateTime?
  allDay       Boolean      @default(false)
  availability Availability @default(BUSY)
  location     String?
  /// The order they were added in, which is the order they are shown.
  position     Int          @default(0)
  createdAt    DateTime     @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_date")
}

enum FieldType {
  TEXT
  LONG_TEXT
  DATE
  NUMBER
  LINK
  SELECT
}

/// A field the workspace invented, asked of every project.
model CustomField {
  id        String    @id @default(cuid())
  name      String
  type      FieldType @default(TEXT)
  /// The choices, for a single select. Empty for every other type.
  options   String[]  @default([])
  /// Whether the client sees it, or only the owner.
  visibleToClient Boolean @default(true)
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  values ProjectFieldValue[]

  @@index([workspaceId, position])
  @@map("custom_field")
}

/// What one project answered for one custom field.
model ProjectFieldValue {
  id    String @id @default(cuid())
  value String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([projectId, fieldId])
  @@index([projectId])
  @@map("project_field_value")
}
