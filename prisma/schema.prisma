// Handled — clientflow for independent businesses.
// Modular monolith: one schema, one database, module-per-domain.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core models)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Workspace — every business record hangs off exactly one workspace.
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("AED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]
  projects    Project[]
  invoices    Invoice[]
  tasks       Task[]
  automations Automation[]
  automationRuns AutomationRun[]

  @@map("workspace")
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects Project[]
  invoices Invoice[]
  automationRuns AutomationRun[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@map("client")
}

// ---------------------------------------------------------------------------
// Projects — the "clientflow" pipeline
// ---------------------------------------------------------------------------

enum ProjectStage {
  INQUIRY
  PROPOSAL_SENT
  BOOKED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Project {
  id          String       @id @default(cuid())
  name        String
  stage       ProjectStage @default(INQUIRY)
  description String?
  eventDate   DateTime?
  valueCents  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoices Invoice[]
  tasks    Task[]
  automationRuns AutomationRun[]

  @@index([workspaceId, stage])
  @@index([clientId])
  @@map("project")
}

// ---------------------------------------------------------------------------
// Invoices & payments — money is always integer minor units.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime?
  dueAt     DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments Payment[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([clientId])
  @@map("invoice")
}

model InvoiceItem {
  id             String @id @default(cuid())
  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  position       Int    @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_item")
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  amountCents Int
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  title       String
  done        Boolean   @default(false)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, done])
  @@map("task")
}

// ---------------------------------------------------------------------------
// Automations — a trigger, then steps that run on their own clock.
//
// Editing is blocked while an automation has a live run, and changes only ever
// affect runs started afterwards; steps already scheduled keep the shape they
// were created with.
// ---------------------------------------------------------------------------

enum AutomationStatus {
  ACTIVE
  INACTIVE
}

enum AutomationTrigger {
  PROJECT_CREATED
  PROJECT_STAGE_CHANGED
  CLIENT_CREATED
  INVOICE_SENT
  INVOICE_PAID
}

enum AutomationAction {
  SEND_EMAIL
  CREATE_TASK
  MOVE_STAGE
}

enum RunStatus {
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum RunStepStatus {
  PENDING
  DONE
  FAILED
}

model Automation {
  id     String            @id @default(cuid())
  name   String
  status AutomationStatus  @default(INACTIVE)
  trigger AutomationTrigger
  /// PROJECT_STAGE_CHANGED only: fires when a project enters this stage.
  triggerStage ProjectStage?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  steps AutomationStep[]
  runs  AutomationRun[]

  @@index([workspaceId, status])
  @@map("automation")
}

model AutomationStep {
  id       String           @id @default(cuid())
  position Int
  action   AutomationAction
  /// Waited *after* the previous step finishes, so delays accumulate down the list.
  delayMinutes Int          @default(0)
  /// SEND_EMAIL: subject. CREATE_TASK: task title.
  subject     String?
  body        String?
  /// MOVE_STAGE: the stage to move the project into.
  targetStage ProjectStage?

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  runSteps AutomationRunStep[]

  @@index([automationId, position])
  @@map("automation_step")
}

model AutomationRun {
  id         String    @id @default(cuid())
  status     RunStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  steps AutomationRunStep[]

  @@index([workspaceId, status])
  @@index([automationId])
  @@map("automation_run")
}

model AutomationRunStep {
  id         String        @id @default(cuid())
  position   Int
  status     RunStepStatus @default(PENDING)
  dueAt      DateTime
  executedAt DateTime?
  /// What actually happened — this is the run timeline the activity tab shows.
  detail     String?

  /// Snapshot of the step as it stood when the run started. Editing an
  /// automation must not rewrite history, so the run carries its own copy and
  /// the link back to the live step is allowed to go null.
  action      AutomationAction
  subject     String?
  body        String?
  targetStage ProjectStage?

  runId  String
  run    AutomationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId String?
  step   AutomationStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([runId, position])
  @@map("automation_run_step")
}
